# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
!*.tfvars.example
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Planes guardados: contienen los valores de las variables sensibles EN CLARO
# (incluido slack_webhook_url), aunque la variable este marcada como sensitive.
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Infracost files
*.binary

# Zips de Lambda generados por data.archive_file
.build/
*.zip

# Archivo de variables real (contiene el email y el webhook de Slack)
terraform.tfvars

# Python
__pycache__/
*.pyc

# AWS CLI instalado dentro del repo por error (no es parte del proyecto)
aws/
awscliv2.zip

# --- Presentacion (AWS Community Day Peru 2026) ---

# Plantilla oficial del evento: no es material propio, no corresponde redistribuirla.
presentacion/template/

# Los entregables finales (PDF y PPTX) SI se versionan: el video de la demo se
# maneja por separado, asi que el deck se mantiene liviano. Fuera quedan los
# archivos de trabajo intermedios.
presentacion/build/_*
presentacion/build/muestra-*

# QR de feedback de Sessionize: es especifico de esta sesion, no le sirve a nadie mas.
presentacion/assets/*feedback-code.png

# Guiones del orador: material personal, se mantienen solo en local.
presentacion/guion.md
presentacion/guion-video-demo.md
